---
import { ClientRouter } from 'astro:transitions';
import { site } from '../data/site';
import Loader from '../components/Loader.astro';
import StatusBar from '../components/StatusBar.astro';
import Palette from '../components/Palette.astro';
import '../styles/tokens.css';
import '../styles/engine.css';
import '../styles/site.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  stage?: string; // initial stage label for this page
  loader?: boolean;
}
const { title, description = site.description, image = '/og.png', stage = 'START', loader = true } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogImage = new URL(image, Astro.site ?? site.url).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: site.name,
  applicationCategory: 'SecurityApplication',
  operatingSystem: 'macOS, Linux',
  description: site.description,
  url: site.url,
  codeRepository: site.repo.href,
  programmingLanguage: 'Go',
};
const rows = Array.from({ length: 18 });
---
<!doctype html>
<html lang="en" transition:animate="none" data-stage={stage}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#11111B" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link rel="preload" href="/fonts/martian-mono-100_800-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/host-grotesk-300_800-normal.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      document.documentElement.classList.add('js');
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div id="curtain" transition:persist="curtain" aria-hidden="true">
      <div class="curtain__rows">{rows.map(() => <span class="curtain__row"></span>)}</div>
      <p class="curtain__cmd"><span class="curtain__caret">›</span> <span data-curtain-cmd></span><span class="caret-block"></span></p>
    </div>
    {loader && <Loader />}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <div transition:persist="chrome">
      <StatusBar />
      <Palette />
    </div>
    <p class="sr-only" aria-live="polite" data-announce></p>
    <script>
      import { start } from '../engine/astro';
      import { setupMotion } from '../motion/setup';
      start(setupMotion);
    </script>
  </body>
</html>
